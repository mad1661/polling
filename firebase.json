{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "polling-d51ee",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "README.md",
      "firestore.rules",
      "scripts/**"
    ],
    "redirects": [
      { "source": "/admin.html", "destination": "/", "type": 301 }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Access-Control-Allow-Origin", "value": "*" },
          { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=604800" }
        ]
      }
    ]
  }
}
